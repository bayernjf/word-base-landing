---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import SocialProof from '../components/SocialProofSection.astro';
import Workflow from '../components/WorkflowSection.astro';
import Extension from '../components/ExtensionSection.astro';
import Learning from '../components/LearningSection.astro';
import MultiPlatform from '../components/MultiPlatformSection.astro';
import Faq from '../components/FaqSection.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="WordBase - Learn Vocabulary by Browsing" description="Browser word picker + AI contextual deep learning. Build your vocabulary across all platforms." lang="en">
  <Nav lang="en" />
  <main>
    <Hero lang="en" />
    <SocialProof lang="en" />
    <Workflow lang="en" />
    <Extension lang="en" />
    <Learning lang="en" />
    <MultiPlatform lang="en" />
    <Faq lang="en" />
    <FinalCTA lang="en" />
  </main>
  <Footer lang="en" />
</BaseLayout>
