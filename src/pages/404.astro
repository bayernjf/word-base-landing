---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<BaseLayout title="404 - WordBase" description="The WordBase page you visited does not exist or has been moved." lang="en">
  <main class="flex min-h-[70vh] flex-col items-center justify-center px-4 pt-16 text-center">
    <p class="bg-gradient-to-r from-indigo-400 via-indigo-300 to-amber-400 bg-clip-text text-7xl font-extrabold text-transparent">404</p>
    <h1 class="mt-4 text-xl font-semibold text-slate-900 dark:text-white">
      Page Not Found
    </h1>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
      The page you visited does not exist or has been moved.
    </p>
    <a href="/" class="mt-8 inline-flex items-center rounded-lg bg-indigo-500 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-indigo-400">
      Back to Home
    </a>
    <div class="mt-10">
      <ThemeToggle />
    </div>
  </main>
</BaseLayout>