---
import Icon from '@bay/landing-ui/components/Icon.astro';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang } = Astro.props;
const currentLang: Lang = lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const faqs = [
  { q: t('faq.q1'), a: t('faq.a1') },
  { q: t('faq.q2'), a: t('faq.a2') },
  { q: t('faq.q3'), a: t('faq.a3') },
  { q: t('faq.q4'), a: t('faq.a4') },
  { q: t('faq.q5'), a: t('faq.a5') },
  { q: t('faq.q6'), a: t('faq.a6') },
];
---

<section id="faq" class="px-4 sm:px-6 py-20 sm:py-28">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium mb-4 bg-indigo-500/10 border border-indigo-500/20 text-indigo-300">
        {t('faq.badge')}
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--color-text)]">
        {t('faq.title')}
      </h2>
    </div>

    <div class="space-y-3">
      {faqs.map((faq, i) => (
        <div
          class="faq-item rounded-xl border overflow-hidden transition-colors bg-slate-900/40 border-slate-800"
          data-index={i}
        >
          <button
            class="faq-toggle w-full flex items-center justify-between gap-4 px-5 py-4 text-left"
            aria-expanded={i === 0 ? 'true' : 'false'}
          >
            <span class="text-sm font-medium text-[var(--color-text)]">{faq.q}</span>
            <Icon name="ChevronDown" size={16} class="faq-chevron shrink-0 transition-transform duration-300 text-[var(--color-text-muted)]" />
          </button>
          <div class={`faq-content overflow-hidden transition-all duration-300 ${i === 0 ? 'max-h-60' : 'max-h-0'}`}>
            <p class="px-5 pb-4 text-sm leading-relaxed text-[var(--color-text-muted)]">
              {faq.a}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var items = document.querySelectorAll('.faq-item');
    items.forEach(function (item) {
      var toggle = item.querySelector('.faq-toggle');
      var content = item.querySelector('.faq-content');
      var chevron = item.querySelector('.faq-chevron');

      if (item.dataset.index !== '0') {
        content.classList.add('max-h-0');
        content.classList.remove('max-h-60');
      }

      toggle.addEventListener('click', function () {
        var isOpen = content.classList.contains('max-h-60');
        if (isOpen) {
          content.classList.remove('max-h-60');
          content.classList.add('max-h-0');
          chevron.classList.remove('rotate-180');
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          content.classList.add('max-h-60');
          content.classList.remove('max-h-0');
          chevron.classList.add('rotate-180');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>
