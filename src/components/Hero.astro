---
import Icon from './Icon.astro';

const features = [
  { label: 'Chrome / Edge / Safari' },
  { label: '免费开源' },
  { label: '离线词典可用' },
  { label: '五端同步' },
];

const platforms = ['Mac', 'Win', 'iOS', 'Android'];

const downloadUrl = 'https://github.com/bayernjf/word-picker/releases/latest';
---

<section class="relative pt-32 pb-20 sm:pt-40 sm:pb-28 px-4 sm:px-6 overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[500px] bg-indigo-500/20 rounded-full blur-[120px] landing-animate-pulse-glow"></div>
    <div class="absolute top-32 right-1/4 w-[350px] h-[350px] bg-fuchsia-500/12 rounded-full blur-[100px]"></div>
    <div class="absolute top-60 left-1/4 w-[300px] h-[300px] bg-emerald-500/10 rounded-full blur-[100px]"></div>
  </div>

  <div class="max-w-4xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium mb-7 bg-indigo-500/10 border border-indigo-500/20 text-indigo-300">
      <Icon name="Sparkles" size={14} />
      默认 Ctrl 悬停即查词 · AI 语境深度学习
    </div>

    <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold tracking-tight leading-[1.05] text-[var(--color-text)]">
      浏览即学习，
      <br />
      让每个生词都
      <span class="landing-gradient-text">不流失</span>
    </h1>

    <p class="mt-6 text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed text-[var(--color-text-muted)]">
      浏览器划词收藏 + AI 语境深度学习，全平台词汇积累。
    </p>

    <div class="mt-9 flex flex-col items-center justify-center gap-3">
      <div class="inline-flex flex-wrap items-center justify-center gap-2">
        <a
          href={downloadUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="ext-download-link inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-semibold bg-emerald-500 text-white shadow-lg shadow-emerald-500/25 hover:bg-emerald-400 hover:shadow-emerald-500/40 hover:scale-[1.02] transition-all"
        >
          安装浏览器插件
          <Icon name="ArrowRight" size={16} />
        </a>
        {platforms.map((platform) => (
          <button
            type="button"
            aria-disabled="true"
            class="unavailable-platform-btn inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-semibold transition-colors border opacity-50 cursor-not-allowed bg-slate-800/60 border-slate-700/60 text-slate-200"
          >
            安装 {platform}
          </button>
        ))}
      </div>
      <a
        href="https://word-base.pages.dev/app"
        class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-semibold transition-colors border bg-slate-800/60 hover:bg-slate-800 border-slate-700/60 text-slate-200"
      >
        打开 Web 版
      </a>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-[var(--color-text-subtle)]">
      {features.map((f) => (
        <span class="flex items-center gap-1.5">
          <Icon name="Check" size={14} class="text-emerald-400" />
          {f.label}
        </span>
      ))}
    </div>

    <div class="mt-10 flex items-center justify-center gap-4 text-xs text-[var(--color-text-subtle)]">
      <span class="flex items-center gap-1"><Icon name="Globe" size={14} /> Web</span>
      <span class="flex items-center gap-1"><Icon name="Monitor" size={14} /> Mac / Win</span>
      <span class="flex items-center gap-1"><Icon name="Smartphone" size={14} /> iOS / Android</span>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var buttons = document.querySelectorAll('.unavailable-platform-btn');
    buttons.forEach(function (btn) {
      var timer = null;
      var tooltip = null;

      function showTooltip(x, y) {
        if (tooltip) return;
        tooltip = document.createElement('div');
        tooltip.setAttribute('role', 'tooltip');
        tooltip.className = 'fixed z-[100] -translate-x-full -translate-y-full whitespace-nowrap rounded-xl border px-6 py-4 text-base font-medium shadow-xl pointer-events-none border-slate-700 bg-slate-900 text-slate-100 shadow-black/30';
        tooltip.textContent = '该平台紧急更新上架中';
        document.body.appendChild(tooltip);
        tooltip.style.left = x + 'px';
        tooltip.style.top = y + 'px';
      }

      function hideTooltip() {
        if (tooltip) {
          tooltip.remove();
          tooltip = null;
        }
      }

      btn.addEventListener('mouseenter', function (e) {
        timer = setTimeout(function () {
          showTooltip(e.clientX, e.clientY);
        }, 300);
      });

      btn.addEventListener('mousemove', function (e) {
        if (tooltip) {
          tooltip.style.left = e.clientX + 'px';
          tooltip.style.top = e.clientY + 'px';
        }
      });

      btn.addEventListener('mouseleave', function () {
        if (timer) clearTimeout(timer);
        timer = null;
        hideTooltip();
      });

      btn.addEventListener('click', function (e) {
        e.preventDefault();
      });
    });
  })();
</script>
