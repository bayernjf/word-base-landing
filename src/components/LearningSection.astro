---
import Icon from '@bay/landing-ui/components/Icon.astro';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang } = Astro.props;
const currentLang: Lang = lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const aiFeatures = [
  {
    icon: 'Sparkles',
    color: '#818cf8',
    title: t('learning.feature.ai.title'),
    desc: t('learning.feature.ai.desc'),
  },
  {
    icon: 'BookOpen',
    color: '#c084fc',
    title: t('learning.feature.story.title'),
    desc: t('learning.feature.story.desc'),
  },
  {
    icon: 'RotateCcw',
    color: '#10b981',
    title: t('learning.feature.srs.title'),
    desc: t('learning.feature.srs.desc'),
  },
];

const practiceModes = [
  { icon: 'BookOpenCheck', label: t('learning.practice.read'), color: '#818cf8' },
  { icon: 'Headphones', label: t('learning.practice.listen'), color: '#c084fc' },
  { icon: 'MessageSquare', label: t('learning.practice.speak'), color: '#f59e0b' },
  { icon: 'PenTool', label: t('learning.practice.write'), color: '#ef4444' },
];

const practiceSuffix = t('learning.practice.suffix');
---

<section id="learning" class="px-4 sm:px-6 py-20 sm:py-28">
  <div class="max-w-6xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium mb-4 bg-fuchsia-500/10 text-fuchsia-300">
        <Icon name="BrainCircuit" size={14} />
        {t('learning.badge')}
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--color-text)]">
        {t('learning.titleLine1')}
        <br class="sm:hidden" />
        {t('learning.titleLine2')}
      </h2>
      <p class="mt-4 leading-relaxed text-[var(--color-text-muted)]">
        {t('learning.subtitle')}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-5 mb-12">
      {aiFeatures.map((f) => (
        <div class="relative p-6 rounded-2xl border overflow-hidden group transition-all bg-[var(--color-card-bg)] border-[var(--color-border)] hover:border-slate-700/80">
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"
            style={`background: radial-gradient(circle at 30% 20%, ${f.color}15, transparent 60%);`}
          ></div>
          <div class="relative">
            <div
              class="w-11 h-11 rounded-xl flex items-center justify-center mb-4"
              style={`background-color: ${f.color}20; color: ${f.color};`}
            >
              <Icon name={f.icon} size={20} />
            </div>
            <h3 class="text-base font-semibold mb-2 text-[var(--color-text)]">{f.title}</h3>
            <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{f.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="rounded-2xl border p-6 sm:p-8 bg-[var(--color-card-solid)] border-[var(--color-border)]">
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 mb-6">
        <div>
          <h3 class="text-lg font-semibold mb-1 text-[var(--color-text)]">{t('learning.practice.title')}</h3>
          <p class="text-sm text-[var(--color-text-muted)]">
            {t('learning.practice.subtitle')}
          </p>
        </div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {practiceModes.map((m) => (
          <div class="flex flex-col items-center gap-2 p-4 rounded-xl border transition-all hover:scale-[1.02] bg-slate-900/40 border-slate-800/60">
            <div
              class="w-10 h-10 rounded-xl flex items-center justify-center"
              style={`background-color: ${m.color}20; color: ${m.color};`}
            >
              <Icon name={m.icon} size={16} />
            </div>
            <span class="text-xs font-medium text-[var(--color-text)]">{m.label}{practiceSuffix}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
