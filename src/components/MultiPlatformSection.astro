---
import Icon from '@bay/landing-ui/components/Icon.astro';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang } = Astro.props;
const currentLang: Lang = lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const platforms = [
  { icon: 'Globe', name: t('platforms.web.name'), desc: t('platforms.web.desc'), color: '#818cf8', delay: '0s' },
  { icon: 'Monitor', name: t('platforms.desktop.name'), desc: t('platforms.desktop.desc'), color: '#c084fc', delay: '0.4s' },
  { icon: 'Smartphone', name: t('platforms.mobile.name'), desc: t('platforms.mobile.desc'), color: '#e879f9', delay: '0.8s' },
];

const syncFeatures = [
  { icon: 'RefreshCw', label: t('platforms.sync.realtime') },
  { icon: 'Cloud', label: t('platforms.sync.cloud') },
  { icon: 'Lock', label: t('platforms.sync.local') },
];

const checklist = [
  t('platforms.checklist.extension'),
  t('platforms.checklist.books'),
  t('platforms.checklist.ai'),
  t('platforms.checklist.importExport'),
];
---

<section
  id="platforms"
  class="px-4 sm:px-6 py-20 sm:py-28 border-y bg-[var(--color-section-alt)] border-[var(--color-border)]"
>
  <div class="max-w-6xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium mb-4 bg-emerald-500/10 text-emerald-300">
        <Icon name="Cloud" size={14} />
        {t('platforms.badge')}
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--color-text)]">
        {t('platforms.title')}
      </h2>
      <p class="mt-4 leading-relaxed text-[var(--color-text-muted)]">
        {t('platforms.subtitle')}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-5 mb-10">
      {platforms.map((p) => (
        <div
          class="relative p-8 rounded-2xl border text-center transition-all landing-animate-float bg-[var(--color-card-bg)] border-[var(--color-border)]"
          style={`animation-delay: ${p.delay};`}
        >
          <div
            class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4"
            style={`background-color: ${p.color}20; color: ${p.color};`}
          >
            <Icon name={p.icon} size={24} />
          </div>
          <h3 class="text-lg font-semibold mb-1 text-[var(--color-text)]">{p.name}</h3>
          <p class="text-sm text-[var(--color-text-muted)]">{p.desc}</p>
        </div>
      ))}
    </div>

    <div class="rounded-2xl border p-6 sm:p-8 bg-[var(--color-card-bg)] border-[var(--color-border)]">
      <div class="grid sm:grid-cols-3 gap-6">
        {syncFeatures.map((f) => (
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 bg-emerald-500/15 text-emerald-400">
              <Icon name={f.icon} size={16} />
            </div>
            <div>
              <span class="text-sm font-medium text-[var(--color-text)]">{f.label}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-6 pt-6 border-t flex flex-wrap gap-x-6 gap-y-2 text-xs border-[var(--color-border)] text-[var(--color-text-subtle)]">
        {checklist.map((item) => (
          <span class="flex items-center gap-1">
            <Icon name="Check" size={12} class="text-emerald-400" />
            {item}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
