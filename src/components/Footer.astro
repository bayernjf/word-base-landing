---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang } = Astro.props;
const currentLang: Lang = lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const year = new Date().getFullYear();
const copyright = t('footer.copyright', { year: String(year) });

const homeHref = currentLang === 'zh' ? '/zh/' : '/';
const privacyHref = getLocalizedPath('/privacy', currentLang);
const termsHref = getLocalizedPath('/terms', currentLang);
const deleteAccountHref = getLocalizedPath('/delete-account', currentLang);

const products = [
  { label: t('footer.products.web'), href: 'https://word-base.pages.dev/app' },
  { label: t('footer.products.extension'), href: '#extension' },
  { label: t('footer.products.platforms'), href: '#platforms' },
];

const legalLinks = [
  { label: t('footer.legal.privacy'), href: privacyHref },
  { label: t('footer.legal.terms'), href: termsHref },
  { label: t('footer.legal.deleteAccount'), href: deleteAccountHref },
];
---

<footer class="border-t mt-20 border-[var(--color-border)] bg-slate-950/50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-10">
      <div class="col-span-2">
        <div class="flex items-center gap-3">
          <a href={homeHref}>
            <svg viewBox="0 0 340 128" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-16 w-auto">
              <defs>
                <linearGradient id="footerBookLeft" x1="10" y1="10" x2="26" y2="54" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#818cf8"/>
                  <stop offset="100%" stop-color="#6366f1"/>
                </linearGradient>
                <linearGradient id="footerBookRight" x1="36" y1="14" x2="52" y2="54" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#a5b4fc"/>
                  <stop offset="100%" stop-color="#818cf8"/>
                </linearGradient>
                <linearGradient id="footerCard" x1="22" y1="16" x2="42" y2="42" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#fbbf24"/>
                  <stop offset="100%" stop-color="#f59e0b"/>
                </linearGradient>
                <linearGradient id="footerTextGrad" x1="72" y1="36" x2="240" y2="92" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#6366f1"/>
                  <stop offset="50%" stop-color="#818cf8"/>
                  <stop offset="100%" stop-color="#f59e0b"/>
                </linearGradient>
              </defs>
              <g transform="translate(4, 24) scale(1.2)">
                <rect x="36" y="14" width="16" height="40" rx="3" fill="url(#footerBookRight)"/>
                <rect x="10" y="10" width="16" height="44" rx="3" fill="url(#footerBookLeft)"/>
                <rect x="22" y="16" width="20" height="28" rx="3.5" fill="url(#footerCard)"/>
                <path d="M26 23.5h12M26 29.5h12M26 35.5h10" stroke="#1f2937" stroke-width="2" stroke-linecap="round" opacity="0.8"/>
              </g>
              <text x="78" y="78" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="50" font-weight="800" fill="url(#footerTextGrad)" letter-spacing="-1.5">WordBase</text>
            </svg>
          </a>
          <span class="text-xs ml-1 text-[var(--color-text-subtle)]">{t('footer.tagline')}</span>
        </div>
      </div>

      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider mb-4 text-slate-500">
          {t('footer.products')}
        </h4>
        <ul class="space-y-2.5">
          {products.map((p) => (
            <li>
              <a href={p.href} class="text-sm transition-colors text-slate-400 hover:text-white">
                {p.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider mb-4 text-slate-500">
          {t('footer.resources')}
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a href="https://github.com/bayernjf/word-base" target="_blank" rel="noopener noreferrer" class="text-sm transition-colors text-slate-400 hover:text-white">
              GitHub
            </a>
          </li>
          <li>
            <BayjfLink size={16} class="text-sm transition-colors text-slate-400 hover:text-white" />
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider mb-4 text-slate-500">
          {t('footer.legal')}
        </h4>
        <ul class="space-y-2.5">
          {legalLinks.map((l) => (
            <li>
              <a href={l.href} class="text-sm transition-colors text-slate-400 hover:text-white">
                {l.label}
              </a>
            </li>
          ))}
          <li>
            <button
              type="button"
              id="analytics-preference-btn"
              class="text-sm transition-colors cursor-pointer text-slate-400 hover:text-white"
            >
              {t('footer.legal.analyticsPref')}
            </button>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t flex flex-col sm:flex-row items-center justify-between gap-4 border-[var(--color-border)]">
      <p class="text-xs text-slate-500" set:html={copyright}></p>
      <div class="flex items-center gap-4">
        <a href={privacyHref} class="text-xs transition-colors text-slate-500 hover:text-slate-300">
          {t('footer.legal.privacy')}
        </a>
        <a href={termsHref} class="text-xs transition-colors text-slate-500 hover:text-slate-300">
          {t('footer.legal.terms')}
        </a>
      </div>
    </div>
  </div>
</footer>
