---
import Icon from '@bay/landing-ui/components/Icon.astro';
import { getLangFromUrl, useTranslations, tRaw, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang } = Astro.props;
const currentLang: Lang = lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const steps = [
  {
    icon: 'MousePointer2',
    color: '#818cf8',
    step: '01',
    title: t('workflow.step01Title'),
    desc: t('workflow.step01Desc'),
  },
  {
    icon: 'Cloud',
    color: '#c084fc',
    step: '02',
    title: t('workflow.step02Title'),
    desc: t('workflow.step02Desc'),
  },
  {
    icon: 'Brain',
    color: '#e879f9',
    step: '03',
    title: t('workflow.step03Title'),
    desc: t('workflow.step03Desc'),
  },
];

const DEMO_PARAGRAPH = 'The most important skill in programming is not knowing everything, but knowing how to learn effectively. When you encounter an unfamiliar concept, take a moment to understand it deeply rather than just memorizing syntax. Great developers build robust mental models that help them tackle novel problems with confidence.';

const DEMO_WORDS = [
  { word: 'programming', pos: 'n.', phonetic: '/ˈproʊɡræmɪŋ/', meaning: '编程；程序设计' },
  { word: 'unfamiliar', pos: 'adj.', phonetic: '/ˌʌnfəˈmɪliər/', meaning: '不熟悉的；陌生的' },
  { word: 'concept', pos: 'n.', phonetic: '/ˈkɑːnsept/', meaning: '概念；观念' },
  { word: 'robust', pos: 'adj.', phonetic: '/roʊˈbʌst/', meaning: '健壮的；稳固的' },
  { word: 'tackle', pos: 'v.', phonetic: '/ˈtækl/', meaning: '处理；解决' },
  { word: 'novel', pos: 'adj.', phonetic: '/ˈnɑːvl/', meaning: '新奇的；新颖的' },
];

const DEMO_WORDS_MAP: Record<string, typeof DEMO_WORDS[0]> = {};
DEMO_WORDS.forEach((w) => { DEMO_WORDS_MAP[w.word] = w; });

const words = DEMO_PARAGRAPH.split(' ');

// Translations for inline script
const i18n = {
  statusOff: t('workflow.demoStatus.off', { mod: '{mod}' }),
  statusOn: t('workflow.demoStatus.on'),
  bookTitle: t('workflow.book.title'),
  countSuffix: t('workflow.book.countSuffix', { count: '{count}' }),
  emptyHtml: t('workflow.book.empty'),
  collected: t('workflow.book.collected'),
  popupCollect: t('workflow.popup.collect'),
  popupCollected: t('workflow.popup.collected'),
};
---

<section id="workflow" class="px-4 sm:px-6 py-20 sm:py-28">
  <div class="max-w-6xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium mb-4 bg-indigo-500/10 text-indigo-300">
        <Icon name="ArrowRight" size={14} />
        {t('workflow.badge')}
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--color-text)]">
        {t('workflow.title')}
      </h2>
      <p class="mt-4 leading-relaxed text-[var(--color-text-muted)]">
        {t('workflow.subtitle')}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-4 mb-12">
      {steps.map((s, i) => (
        <div class="relative">
          <div class="p-6 rounded-2xl border h-full transition-all bg-[var(--color-card-bg)] border-[var(--color-border)] hover:border-slate-700/80">
            <div class="flex items-center gap-3 mb-3">
              <div
                class="w-10 h-10 rounded-xl flex items-center justify-center"
                style={`background-color: ${s.color}20; color: ${s.color};`}
              >
                <Icon name={s.icon} size={20} />
              </div>
              <span class="text-xs font-mono text-[var(--color-text-subtle)]">{s.step}</span>
            </div>
            <h3 class="text-lg font-semibold mb-2 text-[var(--color-text)]">{s.title}</h3>
            <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{s.desc}</p>
          </div>
          {i < steps.length - 1 && (
            <div class="hidden md:block absolute top-1/2 -right-3 z-10">
              <Icon name="ArrowRight" size={20} class="text-slate-700" />
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="rounded-2xl border p-5 sm:p-8 bg-[var(--color-card-bg)] border-[var(--color-border)]">
      <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-4">
            <div class="flex gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full bg-red-400/70"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-yellow-400/70"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-green-400/70"></div>
            </div>
            <span id="demo-status" class="text-xs ml-2 text-[var(--color-text-subtle)]"></span>
          </div>
          <div
            id="demo-paragraph"
            class="relative text-base leading-loose p-5 rounded-xl transition-colors select-text bg-[var(--color-card-solid)]"
          >
            {words.map((rawWord, i) => {
              const cleanWord = rawWord.replace(/[.,!?;:]$/, '');
              const punct = rawWord.slice(cleanWord.length);
              const demoWord = DEMO_WORDS_MAP[cleanWord.toLowerCase()];
              return (
                <span>
                  {demoWord ? (
                    <span
                      class="demo-word relative inline-block cursor-pointer rounded px-0.5 -mx-0.5 transition-all text-slate-200 hover:text-indigo-300"
                      data-word={demoWord.word}
                      data-pos={demoWord.pos}
                      data-phonetic={demoWord.phonetic}
                      data-meaning={demoWord.meaning}
                    >
                      {cleanWord}
                    </span>
                  ) : (
                    <span class="text-[var(--color-text-muted)]">{cleanWord}</span>
                  )}
                  {punct && <span class="text-[var(--color-text-muted)]">{punct}</span>}
                  {i < words.length - 1 ? ' ' : null}
                </span>
              );
            })}
          </div>
          <p class="text-xs mt-3 text-[var(--color-text-subtle)]" id="demo-hint"></p>
        </div>

        <div
          id="word-book"
          class="lg:w-64 shrink-0 rounded-xl border p-4 bg-[var(--color-card-solid)] border-[var(--color-border)]"
        >
          <div class="flex items-center justify-between mb-3">
            <h4 class="text-sm font-semibold text-[var(--color-text)]" id="book-title"></h4>
            <span id="word-count" class="text-xs tabular-nums text-[var(--color-text-subtle)]"></span>
          </div>
          <div id="word-list" class="space-y-1.5 min-h-[120px]"></div>
        </div>
      </div>

      <div id="demo-popup" class="fixed z-50 pointer-events-none hidden" style="left: 0; top: 0;">
        <div class="pointer-events-auto rounded-xl p-3 shadow-2xl border min-w-[220px] relative bg-slate-900 border-slate-700">
          <div class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-3 h-3 rotate-45 bg-slate-900 border-l border-t border-slate-700"></div>
          <div class="flex items-center gap-2 mb-1">
            <span id="popup-word" class="text-sm font-bold text-white"></span>
            <span class="p-0.5 rounded transition-colors text-slate-400">
              <Icon name="Volume2" size={12} />
            </span>
            <span id="popup-pos" class="text-[10px] px-1.5 py-0.5 rounded ml-auto bg-indigo-500/20 text-indigo-300"></span>
          </div>
          <p id="popup-phonetic" class="text-[11px] mb-2 font-mono text-[var(--color-text-subtle)]"></p>
          <p id="popup-meaning" class="text-xs leading-relaxed mb-2.5 text-[var(--color-text-muted)]"></p>
          <button
            id="popup-collect"
            class="w-full flex items-center justify-center gap-1 py-1.5 rounded-lg text-xs font-medium transition-all bg-emerald-500 text-white hover:bg-emerald-400 active:scale-[0.98]"
          >
            <Icon name="Plus" size={12} />
            <span id="popup-collect-text"></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ i18n }}>
  (function () {
    var isMac = /Mac|iPhone|iPad/.test(navigator.platform || '');
    var modKey = isMac ? '⌘ Cmd' : 'Ctrl';
    var modKeyShort = isMac ? 'Cmd' : 'Ctrl';
    var ctrlPressed = false;
    var collected = [];
    var popup = document.getElementById('demo-popup');
    var popupWord = document.getElementById('popup-word');
    var popupPos = document.getElementById('popup-pos');
    var popupPhonetic = document.getElementById('popup-phonetic');
    var popupMeaning = document.getElementById('popup-meaning');
    var popupCollect = document.getElementById('popup-collect');
    var popupCollectText = document.getElementById('popup-collect-text');
    var wordList = document.getElementById('word-list');
    var wordCount = document.getElementById('word-count');
    var demoStatus = document.getElementById('demo-status');
    var demoHint = document.getElementById('demo-hint');
    var bookTitle = document.getElementById('book-title');
    var bookCard = document.getElementById('word-book');
    var activeWordEl = null;

    // Set static text
    if (bookTitle) bookTitle.innerHTML = i18n.bookTitle;
    if (demoHint) demoHint.innerHTML = i18n.statusOff.replace('{mod}', '<kbd class="px-1.5 py-0.5 rounded text-[10px] font-mono border bg-slate-800 border-slate-700 text-slate-300">' + modKeyShort + '</kbd>');
    if (popupCollectText) popupCollectText.textContent = i18n.popupCollect;

    function updateStatus() {
      if (ctrlPressed) {
        demoStatus.textContent = i18n.statusOn;
      } else {
        demoStatus.textContent = i18n.statusOff.replace('{mod}', modKey);
      }
    }
    updateStatus();

    function updateWordList() {
      wordCount.textContent = i18n.countSuffix.replace('{count}', collected.length);
      if (collected.length === 0) {
        wordList.innerHTML = '<p class="text-xs text-center py-8 leading-relaxed text-[var(--color-text-subtle)]">' + i18n.emptyHtml + '</p>';
        return;
      }
      wordList.innerHTML = collected.map(function (w) {
        return '<div class="px-2.5 py-1.5 rounded-lg text-xs flex items-center gap-2 landing-animate-count-up bg-slate-800/50">' +
          '<span class="font-medium truncate text-[var(--color-text)]">' + w.word + '</span>' +
          '<span class="truncate text-[10px] text-[var(--color-text-subtle)]">' + w.meaning + '</span>' +
          '<span class="ml-auto text-emerald-400 text-[10px] shrink-0">' + i18n.collected + '</span>' +
          '</div>';
      }).join('');
    }
    updateWordList();

    function showPopup(word, x, y) {
      popupWord.textContent = word.word;
      popupPos.textContent = word.pos;
      popupPhonetic.textContent = word.phonetic;
      popupMeaning.textContent = word.meaning;
      popup.style.left = x + 'px';
      popup.style.top = y + 'px';
      popup.style.transform = 'translateX(-50%)';
      popup.classList.remove('hidden');

      if (collected.some(function (c) { return c.word === word.word; })) {
        popupCollectText.textContent = i18n.popupCollected;
        popupCollect.classList.remove('bg-emerald-500', 'text-white', 'hover:bg-emerald-400');
        popupCollect.classList.add('bg-emerald-500/20', 'text-emerald-400', 'cursor-default');
      } else {
        popupCollectText.textContent = i18n.popupCollect;
        popupCollect.classList.add('bg-emerald-500', 'text-white', 'hover:bg-emerald-400');
        popupCollect.classList.remove('bg-emerald-500/20', 'text-emerald-400', 'cursor-default');
      }
    }

    function hidePopup() {
      popup.classList.add('hidden');
    }

    function doCollect(wordData, el) {
      if (collected.some(function (c) { return c.word === wordData.word; })) return;

      if (el && bookCard) {
        var wordRect = el.getBoundingClientRect();
        var targetRect = bookCard.getBoundingClientRect();
        var flyX = targetRect.left + targetRect.width / 2 - wordRect.left - wordRect.width / 2;
        var flyY = targetRect.top - wordRect.top + 20;

        el.style.setProperty('--fly-x', flyX + 'px');
        el.style.setProperty('--fly-y', flyY + 'px');
        el.classList.add('landing-animate-fly');

        setTimeout(function () {
          el.classList.remove('landing-animate-fly');
          el.style.color = '';
          el.classList.add('text-emerald-400/70');
          collected.push(wordData);
          updateWordList();
          hidePopup();
        }, 700);
      } else {
        collected.push(wordData);
        updateWordList();
        hidePopup();
      }
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Control' || e.key === 'Meta') {
        e.preventDefault();
        ctrlPressed = true;
        updateStatus();
      }
    });

    document.addEventListener('keyup', function (e) {
      if (e.key === 'Control' || e.key === 'Meta') {
        ctrlPressed = false;
        hidePopup();
        activeWordEl = null;
        updateStatus();
      }
    });

    document.querySelectorAll('.demo-word').forEach(function (el) {
      el.addEventListener('mouseenter', function (e) {
        if (!ctrlPressed) return;
        var wordData = {
          word: el.dataset.word,
          pos: el.dataset.pos,
          phonetic: el.dataset.phonetic,
          meaning: el.dataset.meaning,
        };
        var rect = el.getBoundingClientRect();
        showPopup(wordData, rect.left + rect.width / 2, rect.bottom + 10);
        activeWordEl = el;
        if (ctrlPressed) {
          el.classList.add('underline', 'decoration-indigo-400/50', 'decoration-2', 'underline-offset-4', 'hover:bg-indigo-500/20', 'text-indigo-200');
        }
      });

      el.addEventListener('mouseleave', function () {
        if (!ctrlPressed) {
          hidePopup();
        }
        el.classList.remove('underline', 'decoration-indigo-400/50', 'decoration-2', 'underline-offset-4', 'hover:bg-indigo-500/20', 'text-indigo-200');
      });

      el.addEventListener('click', function (e) {
        e.preventDefault();
        var wordData = {
          word: el.dataset.word,
          pos: el.dataset.pos,
          phonetic: el.dataset.phonetic,
          meaning: el.dataset.meaning,
        };
        doCollect(wordData, el);
      });
    });

    document.addEventListener('click', function (e) {
      if (popup.contains(e.target) || e.target.classList.contains('demo-word')) return;
      if (!ctrlPressed) hidePopup();
    });
  })();
</script>
