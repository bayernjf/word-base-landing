---
import Icon from '@bay/landing-ui/components/Icon.astro';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang } = Astro.props;
const currentLang: Lang = lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const features = [
  {
    icon: 'Keyboard',
    color: '#818cf8',
    title: t('extension.feature.ctrlHover.title'),
    desc: t('extension.feature.ctrlHover.desc'),
  },
  {
    icon: 'Shield',
    color: '#c084fc',
    title: t('extension.feature.shadowDom.title'),
    desc: t('extension.feature.shadowDom.desc'),
  },
  {
    icon: 'Zap',
    color: '#f59e0b',
    title: t('extension.feature.instant.title'),
    desc: t('extension.feature.instant.desc'),
  },
  {
    icon: 'Bookmark',
    color: '#10b981',
    title: t('extension.feature.bookmark.title'),
    desc: t('extension.feature.bookmark.desc'),
  },
  {
    icon: 'Wifi',
    color: '#ef4444',
    title: t('extension.feature.offline.title'),
    desc: t('extension.feature.offline.desc'),
  },
  {
    icon: 'Settings',
    color: '#ec4899',
    title: t('extension.feature.config.title'),
    desc: t('extension.feature.config.desc'),
  },
];
---

<section
  id="extension"
  class="px-4 sm:px-6 py-20 sm:py-28 border-y bg-[var(--color-section-alt)] border-[var(--color-border)]"
>
  <div class="max-w-6xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium mb-4 bg-emerald-500/10 text-emerald-300">
        <Icon name="Download" size={14} />
        {t('extension.badge')}
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--color-text)]">
        {t('extension.titleLine1')}
        <br class="sm:hidden" />
        {t('extension.titleLine2')}
      </h2>
      <p class="mt-4 leading-relaxed text-[var(--color-text-muted)]">
        {t('extension.subtitle')}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {features.map((f) => (
        <div class="p-5 rounded-xl border transition-all group bg-[var(--color-card-bg)] border-[var(--color-border)] hover:border-slate-700/80">
          <div
            class="w-10 h-10 rounded-xl flex items-center justify-center mb-4 transition-transform group-hover:scale-105"
            style={`background-color: ${f.color}20; color: ${f.color};`}
          >
            <Icon name={f.icon} size={20} />
          </div>
          <h3 class="text-sm font-semibold mb-1.5 text-[var(--color-text)]">{f.title}</h3>
          <p class="text-xs leading-relaxed text-[var(--color-text-muted)]">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
