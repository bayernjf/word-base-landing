---
import '../styles/global.css';
import AnalyticsConsentBanner from '../components/AnalyticsConsentBanner.astro';
import { getAltLangUrl, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  lang?: Lang;
}

const {
  title,
  description,
  ogImage = '/preview.png',
  canonical,
  lang = 'en',
} = Astro.props;

const currentLang: Lang = lang;
const htmlLang = currentLang === 'zh' ? 'zh-CN' : 'en';
const ogLocale = currentLang === 'zh' ? 'zh_CN' : 'en_US';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://word-base.bayjf.com';
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// hreflang alternate URLs
const altLangUrl = getAltLangUrl(Astro.url.pathname, currentLang);
const enUrl = currentLang === 'en' ? canonicalUrl : `${siteUrl}${altLangUrl}`;
const zhUrl = currentLang === 'zh' ? canonicalUrl : `${siteUrl}${altLangUrl}`;

// Analytics IDs — support both VITE_* (legacy/shared) and PUBLIC_* (Astro) prefixes.
const gaId =
  import.meta.env.VITE_GA_MEASUREMENT_ID ||
  import.meta.env.PUBLIC_GA_MEASUREMENT_ID ||
  '';
const clarityId =
  import.meta.env.VITE_CLARITY_PROJECT_ID ||
  import.meta.env.PUBLIC_CLARITY_PROJECT_ID ||
  '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'WordBase',
  description: description,
  applicationCategory: 'EducationApplication',
  operatingSystem: 'Web, iOS, Android, macOS, Windows',
  url: siteUrl,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<!doctype html>
<html lang={htmlLang} class="landing-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="英语单词学习, AI 单词应用, SRS 间隔重复, 单词记忆, WordPicker, WordBase, 词汇学习, 多端同步单词, vocabulary learning, AI vocabulary, SRS spaced repetition"
    />
    <meta name="author" content="WordBase" />
    <meta name="theme-color" content="#0a0e1a" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />

    <!-- hreflang -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="WordBase" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD SoftwareApplication -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Theme switch inline script (read from localStorage to avoid FOUC) -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('wordbase-landing-theme');
          var root = document.documentElement;
          if (stored === 'light') {
            root.classList.remove('landing-dark');
            root.classList.add('landing-light');
          } else {
            root.classList.add('landing-dark');
            root.classList.remove('landing-light');
          }
        } catch (e) {}
      })();
    </script>

    <!--
      Analytics loader — ported from shared/lib/analytics.ts
      Consent-aware: GA4 + Clarity only load when user grants consent.
      Default consent mode is "denied" to comply with privacy regulations.
    -->
    <script is:inline define:vars={{ gaId, clarityId }}>
      (function () {
        var CONSENT_KEY = 'wordbase_analytics_consent';
        var _initialized = false;
        var _storageListenerInstalled = false;

        function getConsent() {
          try {
            var v = localStorage.getItem(CONSENT_KEY);
            if (v === 'granted' || v === 'denied') return v;
          } catch (e) {}
          return null;
        }

        function _deleteAnalyticsCookies() {
          if (typeof document === 'undefined') return;
          var prefixes = ['_ga', '_clck', '_clsk', 'CLID', 'ANONCHK', 'MR', 'MUID', 'SM'];
          var items = document.cookie.split(';');
          for (var i = 0; i < items.length; i++) {
            var name = items[i].split('=')[0] && items[i].split('=')[0].trim();
            if (!name) continue;
            var matched = false;
            for (var j = 0; j < prefixes.length; j++) {
              if (name === prefixes[j] || name.indexOf(prefixes[j] + '_') === 0) {
                matched = true;
                break;
              }
            }
            if (!matched) continue;
            document.cookie = name + '=; Max-Age=0; path=/; SameSite=Lax';
            document.cookie =
              name + '=; Max-Age=0; path=/; domain=' + window.location.hostname + '; SameSite=Lax';
          }
        }

        function _disableAnalytics() {
          if (typeof window === 'undefined') return;
          if (typeof window.gtag === 'function') {
            window.gtag('consent', 'update', {
              analytics_storage: 'denied',
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
            });
          }
          if (typeof window.clarity === 'function') {
            window.clarity('consent', false);
          }
          _deleteAnalyticsCookies();
        }

        function _loadGA4(id) {
          if (typeof window === 'undefined') return;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };

          window.gtag('consent', 'default', {
            ad_storage: 'denied',
            analytics_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            wait_for_update: 500,
          });

          if (getConsent() === 'granted') {
            window.gtag('consent', 'update', {
              analytics_storage: 'granted',
            });
          }

          var el = document.createElement('script');
          el.async = true;
          el.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
          document.head.appendChild(el);

          window.gtag('js', new Date());
          window.gtag('config', id, { send_page_view: false });
        }

        function _loadClarity(id) {
          if (typeof window === 'undefined') return;
          if (getConsent() !== 'granted') return;

          window.clarity =
            window.clarity ||
            function () {
              (window.clarity.q = window.clarity.q || []).push(arguments);
            };
          var el = document.createElement('script');
          el.async = true;
          el.src = 'https://www.clarity.ms/tag/' + id;
          document.head.appendChild(el);
        }

        function _loadAnalytics() {
          if (_initialized) return;
          if (typeof window === 'undefined') return;

          if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
            _initialized = true;
            return;
          }

          if (!gaId && !clarityId) return;
          _initialized = true;

          if (gaId) _loadGA4(gaId);
          if (clarityId) _loadClarity(clarityId);
        }

        function trackPageView(pageTitle) {
          if (typeof window === 'undefined') return;
          if (typeof window.gtag !== 'function') return;
          window.gtag('event', 'page_view', {
            page_title: pageTitle || document.title,
            page_location: window.location.href,
            page_path: window.location.pathname,
          });
        }

        function trackEvent(action, params) {
          if (typeof window === 'undefined') return;
          if (typeof window.gtag !== 'function') return;
          var clean = {};
          if (params) {
            for (var k in params) {
              if (params.hasOwnProperty(k) && params[k] !== undefined) {
                clean[k] = params[k];
              }
            }
          }
          window.gtag('event', action, clean);
        }

        function setConsent(state) {
          try {
            localStorage.setItem(CONSENT_KEY, state);
          } catch (e) {}
          if (state === 'granted') {
            if (_initialized) {
              if (typeof window.gtag === 'function') {
                window.gtag('consent', 'update', { analytics_storage: 'granted' });
              }
              if (typeof window.clarity === 'function') {
                window.clarity('consent', true);
              }
            } else {
              _loadAnalytics();
            }
            trackPageView();
          } else {
            _disableAnalytics();
          }
        }

        function _installStorageListener() {
          if (_storageListenerInstalled) return;
          if (typeof window === 'undefined') return;
          _storageListenerInstalled = true;
          window.addEventListener('storage', function (e) {
            if (e.key === CONSENT_KEY) {
              var newVal = e.newValue;
              if (newVal === 'granted') {
                if (!_initialized) {
                  _loadAnalytics();
                } else {
                  if (typeof window.gtag === 'function') {
                    window.gtag('consent', 'update', { analytics_storage: 'granted' });
                  }
                  if (typeof window.clarity === 'function') {
                    window.clarity('consent', true);
                  }
                }
                trackPageView();
              } else if (newVal === 'denied') {
                _disableAnalytics();
              }
            }
          });
        }

        function initAnalytics() {
          _installStorageListener();
          var init = function () {
            var consent = getConsent();
            if (consent === 'granted') {
              _loadAnalytics();
            } else if (consent === null) {
              _initialized = false;
            }
          };
          if (typeof document === 'undefined' || document.readyState !== 'loading') {
            init();
          } else {
            document.addEventListener('DOMContentLoaded', init, { once: true });
          }
        }

        window.wordbase = {
          getConsent: getConsent,
          setConsent: setConsent,
          hasConsent: function () { return getConsent() === 'granted'; },
          trackPageView: trackPageView,
          trackEvent: trackEvent,
          openConsent: function () {
            window.dispatchEvent(new Event('wordbase:open-analytics-consent'));
          },
        };

        initAnalytics();

        document.addEventListener('click', function (e) {
          var btn = e.target.closest('#analytics-preference-btn');
          if (btn) {
            window.dispatchEvent(new Event('wordbase:open-analytics-consent'));
          }
        });
      })();
    </script>
  </head>
  <body>
    <slot />
    <AnalyticsConsentBanner lang={currentLang} />

    <script>
      import { fetchLatestAssets, formatBytes, isSafari } from '@bay/landing-ui/lib/releases';

      // 浏览器扩展的产物在 word-picker 仓库，桌面/移动端在 word-base
      const EXTENSION_REPO = 'bayernjf/word-picker';
      const DESKTOP_REPO = 'bayernjf/word-base';

      function track(platform: string, destination: string) {
        const wb = (window as any).wordbase;
        if (wb && typeof wb.trackEvent === 'function') {
          wb.trackEvent('download_click', { platform, destination });
        }
      }

      function wire(selector: string, platform: string) {
        const links = document.querySelectorAll<HTMLAnchorElement>(selector);
        links.forEach((link) => {
          link.addEventListener('click', () => {
            track(platform, link.dataset.assetUrl ? 'release_asset' : 'github_releases');
          });
        });
        return links;
      }

      function apply(links: NodeListOf<HTMLAnchorElement>, asset: { url: string; size: number } | null) {
        if (!asset) return;
        links.forEach((link) => {
          link.href = asset.url;
          link.dataset.assetUrl = asset.url;
          link.title = formatBytes(asset.size);
        });
      }

      const extLinks = wire('.ext-download-link', 'browser_extension');
      const macLinks = wire('[data-download="mac"]', 'mac');
      const winLinks = wire('[data-download="win"]', 'win');
      const androidLinks = wire('[data-download="android"]', 'android');

      if (extLinks.length) {
        const { assets } = await fetchLatestAssets(EXTENSION_REPO, {
          chrome: 'chrome.zip',
          safari: 'safari.zip',
        });
        // 按钮文案是通用的“安装浏览器插件”，所以按当前浏览器给对应的包
        apply(extLinks, (isSafari() ? assets.safari : assets.chrome) ?? assets.chrome);
      }

      if (macLinks.length || winLinks.length || androidLinks.length) {
        const { assets } = await fetchLatestAssets(DESKTOP_REPO, {
          mac: '.dmg',
          win: '.exe',
          android: '.apk',
        });
        apply(macLinks, assets.mac);
        apply(winLinks, assets.win);
        apply(androidLinks, assets.android);
      }
    </script>
  </body>
</html>
